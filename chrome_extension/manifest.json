{
  "manifest_version": 3,
  "name": "Clove & Rose Hands",
  "version": "3.6.0",
  "description": "Lets the Clove & Rose voice assistant on this PC control Chrome: tabs, clicks, typing, forms, video, reading pages.",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "bookmarks",
    "debugger",
    "history",
    "scripting",
    "sessions",
    "storage",
    "tabGroups",
    "tabs",
    "webNavigation",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Clove Hands",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://meet.google.com/*"
      ],
      "js": [
        "call_route.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
